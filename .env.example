# Postgres connection string (Neon, Supabase, Railway or your own server)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random secret for signing login sessions, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Used once by `npm run db:seed` to create the first admin account
SEED_ADMIN_NAME=Farhan
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
